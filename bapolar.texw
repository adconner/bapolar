class BorderApolarity:
    def __init__(self, Tinfo, basis=True, nonparam_weight=10):
        self.T, self.dims, self.vwts, self.xs = Tinfo
        self.nonparam_weight = nonparam_weight
        self.xs = [-x.T for x in self.xs]
        self.vwts = -self.vwts
        if basis:
            self.Bxs = self.xs
        else:
            self.Bxs = basis_of_lie_algebra(self.xs)
        self.F = self.T.base_ring()
        self.nvars = sum(self.dims)
        self.nvarsx = self.nvars + len(self.Bxs)
        self.vixs = [0]
        for s in self.dims:
            self.vixs.append(self.vixs[-1] + s)
        self.Tdeg = [0 for i in range(len(self.dims))]
        e = self.T.exponents()[0]
        for i,k in e.sparse_iter():
            self.Tdeg[ next(j for j in range(len(self.dims)) 
                            if i < sum(self.dims[:j+1])) ] += k
        self.Tdeg = tuple(self.Tdeg)

        self.get_ring = cache(self.get_ring)
        self.R0 = self.get_ring()
        self.zero = JDat(self,self.R0.ideal())
        self.tm_dim = cache(self.tm_dim)
        self.tm_dim_tperp = cache(self.tm_dim_tperp)
        self.tm_codim_tperp = cache(self.tm_codim_tperp)
        self.tm_target_out = cache(self.tm_target_out)
        self.target_hilbert_series = cache(self.target_hilbert_series)
        self.target_hilbert_series_td = cache(self.target_hilbert_series_td)
        self.Tperp = cache(self.Tperp)
    @

The function \code{get_ring} implements the logic described in
\S\ref{sec:representation}, namely, it forms the $G$-algebra generated by the
variables $a_1,\ldots,a_\ba$, $b_1,\ldots,b_\bb$,
$c_1,\ldots,c_\bc$, $x_1,\ldots,x_k$, $t_1,\ldots,t_{\text{params}}$ subject to the
appropriate commutator relations and with 
degree reverse lexicographic monomial order on the variables 
$a_1,\ldots,a_\ba$, $b_1,\ldots,b_\bb$,
$c_1,\ldots,c_\bc$, $x_1,\ldots,x_k$ and $t_1,\ldots,t_{\text{params}}$ seperately,
with products of monomials between these groups ordered lexicographically. 

The computation of this algebra is expensive, so 
for performance reasons, calling this function actually chooses the
next power of two number of parameters larger than the requested number and
caches the results for the future. 

<<complete=False>>=

    def get_ring(self, params=0):
        print("get_ring",params)
        if params > 0:
            params = next(1<<k for k in range(32) if 1<<k >= params )
        # should give cached rings of power of two size
        lets = 'abcdefghijklmnopqrsuvwyz'
        B = matrix([x.list() for x in self.Bxs]).T
        A = FreeAlgebra(self.F,['%s%d' % (lets[i],j) for i in range(len(self.dims))
            for j in range(self.dims[i])] + 
                ['x%d'%i for i in range(len(self.Bxs))] + ['t%d' % j for j in range(params)])
        yvs = A.gens()[:sum(self.dims)]
        xvs = A.gens()[sum(self.dims):sum(self.dims)+len(self.Bxs)]
        rels = {}
        for (xv1,x1),(xv2,x2) in combinations(zip(xvs,self.Bxs),2):
            x3 = x2*x1 - x1*x2
            if not x3.is_zero():
                xv3 = sum(e*yv for e,yv in zip(B.solve_right(vector(x3.list())).list(),xvs))
                rels[xv2*xv1] = xv1*xv2 + xv3
        for (xv,x),(yi,yv) in product(zip(xvs,self.Bxs),enumerate(yvs)):
            xy = x*vector(self.F,self.Bxs[0].nrows(),{yi:1})
            if not xy.is_zero():
                xyv = sum(e*yv for e,yv in zip(xy.list(),yvs))
                rels[xv*yv] = yv*xv + xyv
        order = TermOrder('wdegrevlex',[self.nonparam_weight]*(sum(self.dims)+len(self.Bxs)))
        if params > 0:
            order = order + TermOrder('degrevlex',params)
        return A.g_algebra(rels,order=order)
@

\code{get_vorder} takes a multidegree $ijk$ as argument and 
computes a basis of 
$(T^\perp)_{ijk}$ as described at the end of \S\ref{sec:representationlast}.

<<complete=False>>=
    
    def x_weight(self, x):
        i,j = x.nonzero_positions()[0]
        wt = tuple(self.vwts.column(i)-self.vwts.column(j))
        for i,j in x.nonzero_positions()[1:]:
            assert wt == tuple(self.vwts.column(i)-self.vwts.column(j))
        return wt

    def weight_le(self, wta, wtb):
        dwt = vector(self.F,map(sub,wtb,wta))
        u = dwt * self.Xi
        return all(e >= 0 for e in u) and u*self.X == dwt

    def lm(self, p, toR0 = False):
        R = self.R0 if toR0 else p.parent()
        if p.is_zero():
            return R.zero()
        return R.prod(R.gen(x)**k for x,k in 
                p.lm().exponents()[0][:self.nvars].sparse_iter())
@


<<complete=False>>=

    def leading_term_coefficients(self,Jxi):
        J,xi = Jxi
        tss = SetSystem()
        for p in J.gens():
            m = self.lm(p)
            if not m.is_constant():
                tss.add_set(emultiset(m),p.coefficient(m))
        return tss
    
    def get_param_ideal(self,J,xi=None):
        if xi is None:
            xi = J.ring().ngens() - self.nvarsx
        if J.ring().ngens() == self.nvarsx:
            assert xi == 0
            return None,None
        R = PolynomialRing(ba.F,J.ring().gens()[self.nvarsx:self.nvarsx+xi],implementation='singular')
        def coerce(t):
            return t((R.zero(),)*self.nvarsx+R.gens())
        I = R.ideal([coerce(p) for p in J.gens() if self.lm(p).is_constant()])
        return I,coerce
    
    def family_dimension(self,J,xi):
        I,_ = self.get_param_ideal(J,xi)
        if I is None:
            return 0
        return I.dimension()

    def lift_param(self,R,t):
        tg = t.parent().ngens()
        Rg = R.ngens()-self.nvarsx
        assert Rg >= tg or all(next(tt.exponents()[0].sparse_iter())[0] < Rg for tt in t.variables())
        return R(t(R.gens()[self.nvarsx:self.nvarsx+tg]+(R.zero(),)*(tg-Rg)))
    
    def get_ideals_for_tm(self, r, tms=[], tmcs=[], Jxi = None, lp_interval_length_bound=oo, 
                          preset_choices = {}, mod=None, simplify_existing=True, modify_lp = lambda lp: None, 
                          square_tests=[]):
        if mod is None:
            mod = self.zero
        if Jxi is None:
            Jxi = (self.R0.ideal([liftR(p,self.R0) for p in mod.J.gens()],side='twosided'), 0)
        tms = tuple(tms)
        tmcs = tuple(tmcs)
        square_tests = tuple(square_tests)
        tmsall = set(tms+tmcs)

        gbbound = max([sum(tm) for tm in tms+tmcs])
        square_gbbound = max([0]+[sum(tm) for tm in square_tests])
        def gb(J):
            xi = J.ring().ngens() - self.nvarsx
            I,subs = JxiDat(self,(J,xi)).forget_xs()
            I = I.groebner_basis(deg_bound = self.nonparam_weight*(gbbound+1)-1,algorithm='libsingular:std') + \
                    [p for p in I.gens() if p.degree() >= self.nonparam_weight*(gbbound+1)]
            return J.ring().ideal([p(subs) for p in I],side='twosided')
        
        xiorig = Jxi[1]

        # opts: 
        # check lp before gb

        def vktolm(vk):
            return mod.get_vss(vk[0])[vk[1]][vk[2]].lm()
                        
        lp = mod.get_linear_program(r,tms,tmcs,
             relation_size_bound=lp_interval_length_bound,square_tests=square_tests)
        modify_lp(lp)
        # bp = BinaryProgramSCIPReopt(lp)
        bp = BinaryProgram(lp)
            
        def is_unset(vk):
            m = vktolm(vk)
            return bp.get_min(m) == 0 and bp.get_max(m) == 1
        
        tss = self.leading_term_coefficients(Jxi)
        for tm in tms+tmcs:
            for v in mod.get_vs(tm):
                if any(t.is_constant() for _,t in tss.iter_sets(Shi=emultiset(v.lm()))):
                    bp.set_min(v.lm(),1)
        
        tmabove = {}
        for tm1,tm2 in Poset([tms,lambda tm1,tm2: all(e <= f for e,f in zip(tm1,tm2))]).relations():
            tmabove.setdefault(tm1,[]).append(tm2)
            
        def fixed_point(Jxi,gb_needed=True,do_square_tests=False):
            J,yi = Jxi
            bp_restore = []
            try:
                newrel = True
                while newrel:
                    newrel = False
                    if not bp.feasible():
                        return
                    if gb_needed:
                        J = gb(J)
                        gb_needed = False
                    if len(J.gens()) == 1 and J.gens()[0] == J.ring().one():
                        return
                    leading_coefficient_by_monomial = {}
                    for p in J.gens():
                        if p.is_zero():
                            continue
                        m = self.lm(p,True)
                        if m.is_one() or liftR(m,mod.R) in mod.ltJ or self.polynomial_tm(m) not in tmsall:
                            continue
                        if bp.get_min(m) == 0:
                            t = p.coefficient(self.lm(p))
                            if bp.get_max(m) == 0:
                                J += t
                                newrel = True
                                gb_needed = True
                            elif t.is_constant():
                                bp.set_min(m,1)
                                bp_restore.append((m,1))
                                newrel = True
                                tm = self.polynomial_tm(m)
                                for tma in tmabove.get(tm,()):
                                    for n in self.all_monomials( map(sub,tma,tm) ):
                                        n *= m
                                        if bp.get_min(n) == 0:
                                            bp.set_min(n,1)
                                            bp_restore.append((n,1))
                            else:
                                leading_coefficient_by_monomial.setdefault(t,[]).append(m)
                    for t, ms in leading_coefficient_by_monomial.items():
                        for m in ms:
                            bp.set_min(m,1)
                        if not bp.feasible():
                            J += t
                            newrel = True
                            gb_needed = True
                        for m in ms:
                            bp.set_min(m,0)
                    if do_square_tests and len(square_tests) > 0:
                        print("SQUARE TESTS")
                        if gb_needed:
                            J = gb(J)
                            gb_needed = False
                        I,subs = JxiDat(self,(J,yi)).forget_xs()
                        II = I.ring().ideal((I*I).groebner_basis(deg_bound = self.nonparam_weight*(square_gbbound+1)-1,algorithm='libsingular:std'))
                        leading_coefficient_by_monomial = {}
                        for p in II.gens():
                            if p.is_zero():
                                continue
                            p = p(subs)
                            m = self.lm(p,True)
                            if m.is_one() or self.polynomial_tm(m) not in square_tests:
                                continue
                            if bp.get_min((m,2)) == 0:
                                t = p.coefficient(self.lm(p))
                                if bp.get_max((m,2)) == 0:
                                    J += t
                                    newrel = True
                                    gb_needed = True
                                elif t.is_constant():
                                    bp.set_min((m,2),1)
                                    bp_restore.append(((m,2),1))
                                    newrel = True
                                else:
                                    leading_coefficient_by_monomial.setdefault(t,[]).append(m)
                        for t, ms in leading_coefficient_by_monomial.items():
                            for m in ms:
                                bp.set_min((m,2),1)
                            if not bp.feasible():
                                J += t
                                newrel = True
                                gb_needed = True
                            for m in ms:
                                bp.set_min((m,2),0)
                                    
                J,_,yi = self.quick_simplify((J,[J.ring().one()],yi),0 if simplify_existing else xiorig)
                yield (J,yi)
            finally:
                for m,hi in bp_restore:
                    if hi == 1:
                        bp.set_min(m,0)
                    else:
                        bp.set_max(m,1)


        from copy import deepcopy
        vkstart,vkbelowcnt,wkabove = mod.get_poset_info_for_search((), (), tms)
        vkstart = deepcopy(vkstart)
        vkbelowcnt = deepcopy(vkbelowcnt)
        processed = [0]
        vstr_width = [0]
        chosen_vks = []
        def dfs(Jxi):
            def vkremove(vk,added=None):
                # print ('%sremove1'%(' '*processed[0]),vk)
                vkstart.remove(vk)
                for wk in wkabove[vk]:
                    vkbelowcnt[wk] -= 1
                    if vkbelowcnt[wk] == 0:
                        # print ('%sadd2'%(' '*processed[0]),wk)
                        vkstart.add(wk)
                        if added is not None:
                            added.append(wk)
                processed[0] += 1
                return added
            def vkadd(vk,removed=None):
                # print ('%sadd3'%(' '*processed[0]),vk)
                for wk in wkabove[vk]:
                    if vkbelowcnt[wk] == 0:
                        # print ('%sremove2'%(' '*processed[0]),wk)
                        vkstart.remove(wk)
                        if removed is not None:
                            removed.append(wk)
                    vkbelowcnt[wk] += 1
                # print ('%sadd1'%(' '*processed[0]),vk)
                vkstart.add(vk)
                processed[0] -= 1
                return removed
            
            num_in = { tm : len([None for v in mod.get_vs(tm) if bp.get_min(v.lm()) == 1 ]) for tm in tmsall}
            num_out = { tm : len([None for v in mod.get_vs(tm) if bp.get_max(v.lm()) == 0 ]) for tm in tmsall}
                    
            set_stack = []
            set_to_process = [vk for vk in vkstart if not is_unset(vk)]
            while len(set_to_process) > 0:
                vk = set_to_process.pop()
                set_stack.append(vk)
                added = vkremove(vk,[])
                for wk in added:
                    if not is_unset(wk):
                        set_to_process.append(wk)
                        
            def heuristic(vk):
                tm, wt, vi = vk
                tmlast, wtlast, vilast = chosen_vks[-1] if len(chosen_vks) > 0 else (None, None, None)
                # return (0 if tm == tmlast else 1, sum(tm), max(tm)
                return (sum(tm), max(tm), self.tm_dim_tperp(tm)-num_in[tm]-num_out[tm], 
                        0 if tm == tmlast and wt == wtlast else 1, sum(wt))
                
            try:
                vk = min(vkstart,key=heuristic)
            except ValueError:
                while len(set_stack) > 0:
                    vk = set_stack.pop()
                    vkadd(vk)
                yield Jxi
                return
            
            set_stack.append(vk)
            vkremove(vk)
            chosen_vks.append(vk)
            try:
                tm,wt,vi = vk
                vs = mod.get_vss(tm)[wt]
                v = vs[vi]

                if len(chosen_vks) == 1 or chosen_vks[-2][0] != tm:
                    if len(list(fixed_point(Jxi,gb_needed=False,do_square_tests=True))) == 0:
                        return
                
                try:
                    var_lp_val = next(v for x,v in bp.extend() if x == mod.get_vss(tm)[wt][vi].lm())
                except StopIteration:
                    var_lp_val = 0.5
                
                assert is_unset(vk)
                
                def printstep(extra=''):
                    remhi = len(mod.get_vs(tm)) - self.tm_target_out(r,tm) - num_in[tm]
                    remlo = self.tm_target_out(r,tm) - num_out[tm]
                    vstr = str(v.lm())
                    vstr_width[0] = max(vstr_width[0],len(vstr))
                    print ('%s %s xi=%d %.2f %s%d %d %s' % (str(tm),vstr.rjust(vstr_width[0]),
                                                Jxi[1],var_lp_val,' '*len(chosen_vks),remhi,remlo,extra))
                printstep()

                def plus_cur(Jxi):
                    J,xi = Jxi
                    cur_params = J.ring().ngens() - self.nvarsx
                    yi = xi + len([w for w in vs[:vi] if bp.get_min(w.lm()) == 0])
                    if yi > cur_params:
                        R = self.get_ring(yi)
                        J = R.ideal([liftR(p,R) for p in J.gens()])
                    R = J.ring()
                    p = liftR(v,R) + R.sum([liftR(w,R)*R.gen(self.nvarsx+xi+wi)
                                for wi,w in enumerate(w for w in vs[:vi] if bp.get_min(w.lm()) == 0)])
                    ptm = self.polynomial_tm(p)
                    return (bounded_gb(J+p, gbbound),yi)
                    I,_ = JxiDat(self,(J,xi)).forget_xs()
                    toI = I.ring().gens()[:self.nvars]+(I.ring().zero(),)*(self.nvarsx-self.nvars)+I.ring().gens()[self.nvars:]
                    I = Sequence([q for q in I.gens() if self.polynomial_tm(q) == ptm])
                    queue = [p]
                    while queue: 
                        p = queue.pop()
                        Ilast = I
                        I = Sequence(I + [p(toI)]).reduced()
                        if I != Ilast:
                            J += p
                            for x in R.gens()[self.nvars:self.nvarsx]:
                                xp = x*p - p*x
                                if not xp.is_zero():
                                    queue.append(xp)
                    return (J,yi)
                
                # rem = self.tm_dim_tperp(tm)-num_in[tm]-num_out[tm]
                # assert rem > 0
                                    
                if var_lp_val > 0.5 and preset_choices.get(v.lm(),True):
                    bp.set_min(v.lm(),1)
                    for Jxip in fixed_point(plus_cur(Jxi)):
                    # for Jxip in fixed_point(plus_cur(Jxi),do_square_tests = rem==1):
                        for res in dfs(Jxip):
                            yield res
                    bp.set_min(v.lm(),0)
                        
                if preset_choices.get(v.lm(),False) == False:
                    bp.set_max(v.lm(),0)
                    for Jxip in fixed_point(Jxi,False):
                        for res in dfs(Jxip):
                            yield res
                    bp.set_max(v.lm(),1)
                        
                if var_lp_val <= 0.5 and preset_choices.get(v.lm(),True):
                    bp.set_min(v.lm(),1)
                    for Jxip in fixed_point(plus_cur(Jxi)):
                    # for Jxip in fixed_point(plus_cur(Jxi),do_square_tests = rem==1):
                        for res in dfs(Jxip):
                            yield res
                    bp.set_min(v.lm(),0)
                        
            finally:
                chosen_vks.pop()
                while len(set_stack) > 0:
                    vk = set_stack.pop()
                    vkadd(vk)

        for Jxif in fixed_point(Jxi):
            for Jxi in dfs(Jxif):
                if len(list(fixed_point(Jxi,gb_needed=False,do_square_tests=True))) == 0:
                    continue
                yield Jxi

    def tm_dim(self, tm):
        return prod(binomial(d+t-1,t) for t,d in zip(tm,self.dims))

    def tm_dim_tperp(self, tm):
        if all(a <= b for a,b in zip(tm,self.Tdeg)):
            return len(self.zero.get_vs(tm))
        else:
            return self.tm_dim(tm)

    def tm_codim_tperp(self, tm):
        return self.tm_dim(tm) - self.tm_dim_tperp(tm)
    
    def tm_target_out(self, r, tm): 
        return min(self.tm_dim_tperp(tm),r-self.tm_codim_tperp(tm))

    def polynomial_tm(self, p):
        if p.is_zero():
            return (0,)*len(self.Tdeg)
        e = p.exponents()[0]
        return tuple(sum(k for _,k in e[a:b].sparse_iter()) 
                for a,b in zip(self.vixs,self.vixs[1:]))

    def polynomial_weight(self, p):
        e = p.exponents()[0]
        if e.is_constant():
            return (0,)*self.vwts.nrows()
        return tuple(sum(k*self.vwts[:,xi] for xi,k in e.sparse_iter()).list())

    def all_monomials(self, tm, R=None):
        if R is None:
            R = self.get_ring()
        for y in cartesian_product([IntegerVectors(a,d) 
                for a,d in zip(tm,self.dims) ]):
            yield R.prod(x**k for k,x in 
                    zip((k for e in y for k in e),R.gens()) if k>0)

    def sum_ideals(self,Jxis,xi_common=0):
        assert xi_common == 0 or all(xi >= xi_common for J,xi in Jxis)
        sxis = xi_common + sum(xi-xi_common for J,xi in Jxis)
        R = self.get_ring(sxis)
        gens = []
        Sgens = []
        xcum = xi_common
        for J,xi in Jxis:
            xi_new = xi - xi_common
            gens.extend([p(R.gens()[:self.nvarsx+xi_common] +
                R.gens()[self.nvarsx+xcum:self.nvarsx+xcum+xi_new] +
                (R.zero(),) * (J.ring().ngens()-self.nvarsx-xi))
                for p in J.gens()])
            xcum += xi_new
        assert xcum == sxis
        return (R.ideal(gens,side='twosided'),xcum)

    def quick_simplify(self,Jxi,starti=0):
        J,S,xi = Jxi
        assert xi >= starti
        if xi == 0:
            return (J,[J.ring().one()],0)
        
        # if variables never occur, add a relation for them so they will be
        # eliminated in the next step. Missing variables should only be
        # produced with complete=True searches
        tis = set()
        for p in J.gens():
            for e in p.exponents(): 
                for ti,_ in e[self.nvarsx:].sparse_iter():
                    tis.add(ti)
        J += [J.ring().gen(self.nvarsx+ti) for ti in set(range(starti,xi)).difference(tis)]
        
        I,coerce = self.get_param_ideal(J)
        subs = list(I.ring().gens()[:xi]) + [I.ring().zero()]*(I.ring().ngens()-xi)
        for ti,t in enumerate(I.ring().gens()[:xi]):
            if ti >= starti:
                subs[ti] = I.reduce(t)
        tis = set()
        for p in subs:
            for e in p.exponents():
                for ti,_ in e.sparse_iter():
                    tis.add(ti)
        assert all(i in tis for i in range(starti))
        tis = sorted(tis)
        ssubs = [I.ring().zero()]*I.ring().ngens()
        for j,ti in enumerate(tis):
            ssubs[ti] = I.ring().gen(j)
        subs = [t(*ssubs) for t in subs]

        R = self.get_ring(len(tis))
        S = [self.lift_param(R,I.reduce(coerce(s)(subs))) for s in S]
        S = [R.one()] + [s for s in S if not s.is_constant()]
        
        subs = list(R.gens()[:self.nvarsx]) + [self.lift_param(R,t) for t in subs]
        Jg = [p(*subs) for p in J.gens()]
        Jg = [p for p in Jg if not p.is_zero()]
        J = R.ideal(Jg,side='twosided')
        return (J,S,len(tis))

    def containing_leading_term_ideal(self,Jxi):
        J,xi = Jxi
        R = PolynomialRing(self.F,self.R0.gens()[:self.nvars])
        ltIub = []
        for p in J.gens():
            m = self.lm(p)
            if not m.is_constant():
                ltIub.append(m)
        return R.ideal(ltIub)
            
    def contained_leading_term_ideal(self,Jxi):
        J,xi = Jxi
        if xi == 0:
            return self.containing_leading_term_ideal(Jxi)
        I,coerce = self.get_param_ideal(J)
        R = PolynomialRing(self.F,self.R0.gens()[:self.nvars])
        ltIlb = []
        for p in J.gens():
            m = self.lm(p)
            if not m.is_constant():
                t = p.coefficient(m)
                if 1 in I + coerce(t):
                    ltIlb.append(m(R.gens()+(R.zero(),)*(p.parent().ngens()-R.ngens())))
        return R.ideal(ltIlb)
    
    def trivially_contained_leading_term_ideal(self,Jxi):
        J,xi = Jxi
        R = PolynomialRing(self.F,self.R0.gens()[:self.nvars])
        ltIlb = []
        for p in J.gens():
            m = self.lm(p)
            if not m.is_constant():
                t = p.coefficient(m)
                if t.is_constant():
                    ltIlb.append(m(R.gens()+(R.zero(),)*(p.parent().ngens()-R.ngens())))
        return R.ideal(ltIlb)

    def codimension_bounds(self,Jxi,total_degree):
        J,xi = Jxi
        I,subs = JxiDat(self,(J,xi)).forget_xs()
        I = I.ring().ideal(I.groebner_basis(deg_bound = 10*(total_degree+1)-1,algorithm='libsingular:std'))
        J = J.ring().ideal([p(subs) for p in I.gens()],side='twosided')
        ltIlb = self.contained_leading_term_ideal(Jxi)
        ltIub = self.containing_leading_term_ideal(Jxi)
        res = {}
        for m in ltIub.normal_basis(total_degree):
            res.setdefault(self.polynomial_tm(m),[0,0])[0] += 1
        for m in ltIlb.normal_basis(total_degree):
            res.setdefault(self.polynomial_tm(m),[0,0])[1] += 1
        return res,ltIlb,ltIub
    
    def apolar_to(self,Jxi,tm,action = 'partial_derivative'):
        J,xi = Jxi
        R = PolynomialRing(self.F,self.T.parent().gens()+tuple('t%d' % i for i in range(xi)))
        def liftR(p):
            return p(R.gens()[:self.nvars] + (R.zero(),)*(self.nvarsx - self.nvars) + R.gens()[self.nvars:])
        ps = {}
        for m in self.all_monomials(tm,J.ring()):
            mr = J.reduce(m)
            if m == mr:
                ps[m] = ps.get(m,R.zero()) + liftR(m)
            else:
                while not mr.is_zero():
                    n = ba.lm(mr)
                    t = mr.coefficient(n)
                    if action == 'partial_derivative':
                        ps[n] = ps.get(n, R.zero()) + liftR(t) * liftR(m) * prod(factorial(k) for _,k in n.exponents()[0].sparse_iter()) /\
                                    prod(factorial(k) for _,k in m.exponents()[0].sparse_iter())
                    elif action == 'divided_power':
                        ps[n] = ps.get(n, R.zero()) + liftR(t) * liftR(m)
                    else:
                        raise ValueError("action must be 'partial_derivative' or 'divided_power'")
                    mr -= n*t
        return list(ps.values())
    
    def ideal_constant_generators(self,J):
        return self.R0.ideal([liftR(p,self.R0) for p in J.gens() if 
              all(e[self.nvars:].is_constant() for e in p.exponents())],side='twosided')
        
    def target_hilbert_series(self,r):
        ts = FractionField(PolynomialRing(QQ,'t',len(self.dims))).gens()
        hs = r/prod(1-t for t in ts)
        k = 0
        while True:
            done = True
            for tm in IntegerVectors(k,len(self.dims)):
                tm = tuple(tm)
                if self.tm_dim(tm) < r:
                    hs -= (r-self.tm_dim(tm))*prod(t**e for t,e in zip(ts,tm))
                    done = False
            if done:
                break
            k += 1
        return hs

    def target_hilbert_series_td(self,r):
        t = FractionField(PolynomialRing(QQ,'t')).gen()
        hs = self.target_hilbert_series(r)
        return hs((t,)*hs.parent().ngens())

    def Tperp(self):
        tms = [(0,)*i+(e+1,)+(0,)*(len(self.Tdeg)-i-1)
             for i,e in enumerate(self.Tdeg)]
        tms.extend(product(*[range(e+1) for e in self.Tdeg]))
        return self.R0.ideal([v for tm in tms for vs in 
                        self.zero.get_vss(tm).values() for v in vs]).twostd()
        
    def bounded_tangent_space_equations(self, Jxi, tms):
        J,xi = Jxi
        J = J.ring().ideal([p for p in J.gens() if self.polynomial_tm(p) in tms],side='twosided')
        Jxi = JxiDat(self,(J,xi))
        deg = max(sum(tm) for tm in tms)
        from sage.libs.singular.option import opt,opt_ctx
        with opt_ctx:
            opt['deg_bound'] = self.nonparam_weight*(deg+1)-1
            syz = ff.syz(J)
            if syz[0].is_zero():
                syz = []
        degsyz = lambda s: next(tuple(map(lambda a,b: a+b, self.polynomial_tm(p), self.polynomial_tm(e)))
                      for p,e in zip(J.gens(),s) if not e.is_zero())
        syz = [(degsyz(s),s) for s in syz if degsyz(s) in tms]
        # eqs := (syz, nb(deg s)), vars = (gi, nb(tm))
        vari = {(gi,m) : i for i,(gi,m) in enumerate((gi,m) for gi,g in enumerate(J.gens()) 
                                                     for m in Jxi.normal_basis_tm(self.polynomial_tm(g)) ) }
        eqsi = {(si, m) : i for (i,(si,m)) in enumerate((si,m) for si,(tm,_) in enumerate(syz) 
                                                             for m in Jxi.normal_basis_tm(tm)) }
        R = self.F if xi == 0 else PolynomialRing(self.F,'t',xi,implementation='singular')
        Rsubs = (R.zero(),)*self.nvarsx+(R.gens() if R is not self.F else ())+\
                (R.zero(),)*(J.ring().ngens()-self.nvarsx-xi)
        eqs = {}
        from sage.libs.singular.groebner_strategy import NCGroebnerStrategy
        Jn = NCGroebnerStrategy(J)
        for si,(tm,s) in enumerate(syz):
            for gi, e in s.dict().items():
                for m in Jxi.normal_basis_tm(self.polynomial_tm(J.gen(gi))):
                    me = Jn.normal_form(liftR(m,J.ring())*e)
                    while not me.is_zero():
                        lm = self.lm(me)
                        t = me.coefficient(lm)
                        eqs[(eqsi[(si,lm)], vari[(gi,m)])] = t(Rsubs)
                        me -= t*lm
        return matrix(R,len(eqsi),len(vari),eqs)
    
    # returns the chain complex Hom(F_i, R/(J+B))_0, where F_i is a free resolution of (J+B)/I, of length k
    # where B is empty in all degree less or equal to one in tms, and full otherwise (if tms is None, B is 0)
    # Use k=0 to get a matrix whose left kernel is the tangent space (B=0), and
    # use k=1 to get matrices m1 and m2 for which 
    # lker m2 / rim m1 = Ext_1((J+B)/I, R/(J+B))_0
    def bounded_Hom_complex0(self, Jxi, tms=None, Ixi=None, k=0):
        J,xi = Jxi
        tm_in = (lambda tm: True) if tms is None else (lambda tm: any( all(e<=f for e,f in zip(tm, tmh)) for tmh in tms))
        J = J.ring().ideal([p for p in J.gens() if tm_in(self.polynomial_tm(p))],side='twosided')
        Jxi = JxiDat(self,(J,xi))
        deg = None if tms is None else max(sum(tm) for tm in tms)
        Jflat,subs = Jxi.forget_xs()
        from sage.libs.singular.option import opt,opt_ctx
        with opt_ctx:
            opt['deg_bound'] = 0 if tms is None else self.nonparam_weight*(deg+1)-1
            Jgens = ff.minbase(Jflat)
        Jgendegs = [self.polynomial_tm(e) for e in Jgens]
        def syz_deg(syz, edegs):
            assert not syz.is_zero()
            cur = None
            for f,edeg in zip(syz,edegs):
                if f != 0:
                    fdeg = tuple(map(add,self.polynomial_tm(f),edeg))
                    if cur is None:
                        cur = fdeg
                    else:
                        assert cur == fdeg
            return cur
        degs = [Jgendegs]
        with opt_ctx:
            opt['deg_bound'] = 0 if tms is None else self.nonparam_weight*(deg+1)-1
            opt['returnSB'] = False
            if Ixi is None:
                rels = ff.syz(matrix(Jgens))
            else:
                rels = ff.modulo(Jgens, JxiDat(self, Ixi).forget_xs()[0] )
        rels = [c for c in rels if not c.is_zero() and tm_in(syz_deg(c,Jgendegs))]
        ms = [matrix(rels).T]
        degs.append([ syz_deg(c,Jgendegs) for c in rels ])
        
        for _ in range(k):
            with opt_ctx:
                # opt['deg_bound'] = self.nonparam_weight*(deg+1)-1
                opt['deg_bound'] = 0 if tms is None else self.nonparam_weight*(deg-min(sum(tm) for tm in degs[-2])+1)-1
                opt['returnSB'] = False
                rels = ff.syz(ms[-1])
            rels = [c for c in rels if not c.is_zero() and tm_in(syz_deg(c,degs[-1]))]
            ms.append(matrix(rels).T)
            degs.append([ syz_deg(c,degs[-1]) for c in rels ])
        ms = [m.apply_map(lambda e: e(subs), subs[0].parent()) for m in ms]
        
        @cache
        def canonical_index(m,tm):
            return Jxi.normal_basis_tm(tm).index(m)
        
        R = self.F if xi == 0 else PolynomialRing(self.F,'t',xi,implementation='singular')
        Rsubs = (R.zero(),)*self.nvarsx+(R.gens() if R is not self.F else ())+\
                (R.zero(),)*(J.ring().ngens()-self.nvarsx-xi)
        from sage.libs.singular.groebner_strategy import NCGroebnerStrategy
        Jn = NCGroebnerStrategy(J)
        def mult_mapT(e, tm_to, tm_from, row_offset, cur_col_offset, M):
            emat = {}
            for mi,m in enumerate(Jxi.normal_basis_tm(tm_from)):
                me = Jn.normal_form(liftR(m,J.ring())*e)
                while not me.is_zero():
                    lm = self.lm(me)
                    t = me.coefficient(lm)
                    M[ (row_offset + mi, cur_col_offset + canonical_index(lm,tm_to)) ] = t(Rsubs)
                    me -= t*lm
        
        out = []
        for m,dsr,dsc in zip(ms,degs,degs[1:]):
            if len(dsc) == 0:
                out.append(matrix(R, sum(len(Jxi.normal_basis_tm(dr)) for dr in dsr), 0, sparse=True))
                continue
            M = {}
            row_offset = 0
            col_offset = None
            for dr,r in zip(dsr, m):
                cur_col_offset = 0
                for dc,e in zip(dsc, r):
                    mult_mapT(e,dc,dr,row_offset,cur_col_offset,M)
                    cur_col_offset += len(Jxi.normal_basis_tm(dc))
                if col_offset is None:
                    col_offset = cur_col_offset
                else:
                    assert col_offset == cur_col_offset
                row_offset += len(Jxi.normal_basis_tm(dr))
            out.append(matrix(R,row_offset,col_offset,M))
        return out
                
        
    # For testing purposes
    # This gives the monomials not in the leading term ideal for a generic point
    # in the family of ideals corresponding to J. If the family J is not
    # irreducible, this gives the intersection of this set of monomials over all
    # the irreducible components of J
    # it is assumed that the family J is nonempty (1 not in J)
    def generic_codim(self,J,tm):
        msin = set()
        for p in J.gens():
            m = self.lm(p,True)
            if not m.is_constant(): # otherwise a defining equation of the family
                for n in self.all_monomials(map(sub,tm,self.polynomial_tm(m))):
                    msin.add(m*n)
        return [m for m in self.all_monomials(tm) if m not in msin]
    
class JDat:
    def __init__(self, ba, J):
        assert all(e[ba.nvars:].is_constant() for p in J.gens() for e in p.exponents())
        self.ba = ba
        self.R = PolynomialRing(ba.F,ba.R0.gens()[:ba.nvars])
        self.J = self.R.ideal([liftR(p,self.R) for p in J.gens()])
        self.ltJ = self.R.ideal([p.lm() for p in self.J.groebner_basis()])
        self.normal_basis = cache(self.normal_basis)
        self.get_vss = cache(self.get_vss)
        self.get_vs = cache(self.get_vs)
        self.get_poset = cache(self.get_poset)
        self.get_poset_info_for_search = cache(self.get_poset_info_for_search)
        self.get_quiver_representation = cache(self.get_quiver_representation)
        self.get_linear_program_except_r = cache(self.get_linear_program_except_r)
        
    def normal_basis(self,d):
        return [liftR(m,ba.R0) for m in self.J.normal_basis(d)]
    
    def get_vss(self,tm):
        vs = self.normal_basis(sum(tm))
        vss = {}
        for v in vs:
            if ba.polynomial_tm(v) == tm:
                vss.setdefault(ba.polynomial_weight(v),[]).append(v)
        todel = []
        for wt in vss:
            vs = vss[wt]
            vs.sort(reverse=True)
            if all(a <= b for a,b in zip(tm,ba.Tdeg)): # restrict to Tperp
                ms = []
                msix = {}
                eqs = {}
                for vi,v in enumerate(vs):
                    Td = ba.T
                    for i,k in v.exponents()[0].sparse_iter():
                        for _ in range(k):
                            Td = Td.derivative(Td.parent().gen(i))
                    for m,c in Td.dict().items():
                        if m not in msix:
                            msix[m] = len(ms)
                            ms.append(m)
                        eqs[(msix[m], vi)] = c
                eqs = matrix(ba.F, len(ms), len(vs), eqs)
                K = eqs.right_kernel_matrix()
                vs = [sum(e*vs[i] for i,e in enumerate(r)) for r in K]
            vss[wt] = list(reversed(vs))
            if len(vss[wt]) == 0:
                todel.append(wt)
        for wt in todel:
            del vss[wt]
        return vss
    
    def get_vs(self, tm):
        vss = self.get_vss(tm)
        P = self.get_poset((),(tm,))
        return [vss[wt][i] for _,wt,i in P.linear_extension()]
    
    def get_poset(self, tms=(), tms_high_to_low=(), tms_low_to_high=()):
        vsix = {}
        lmtov = {}
        tms = tms + tms_high_to_low + tms_low_to_high
        g = DiGraph()
        for tm in tms:
            for wt,vs in self.get_vss(tm).items():
                for vi,v in enumerate(vs):
                    lmtov[v.lm()] = v
                    vk = (tm,wt,vi)
                    vsix[v] = vk
                    g.add_vertex(vk)
        for tm in tms:
            for vs in self.get_vss(tm).values():
                for x in ba.R0.gens()[ba.nvars:ba.nvars+len(ba.xs)]:
                    wi = 0
                    for v in vs:
                        vk = vsix[v]
                        w = liftR(self.J.reduce(liftR(x*v-v*x,self.R)),ba.R0)
                        if w.is_zero():
                            continue
                        _,wt,wicur = vsix[lmtov[w.lm()]]
                        wi = max(wi,wicur)
                        for i in range(wi+1):
                            g.add_edge(vk,(tm,wt,i))
                        wilast = wi
        for tm in tms_high_to_low:
            for vs in self.get_vss(tm).values():
                for v,w in zip(vs,vs[1:]):
                    g.add_edge(vsix[w],vsix[v])
        for tm in tms_low_to_high:
            for vs in self.get_vss(tm).values():
                for v,w in zip(vs,vs[1:]):
                    g.add_edge(vsix[v],vsix[w])
                            
        tmposet = Poset((tms,lambda a,b: all(i<=j for i,j in zip(a,b))))
        for tm,tmr in tmposet.cover_relations():
            for vs in self.get_vss(tm).values():
                for v in vs:
                    vk = vsix[v]
                    for m in ba.all_monomials(tuple(map(sub,tmr,tm))):
                        w = v*m
                        w = liftR(self.J.reduce(liftR(v*m,self.R)),ba.R0)
                        if w.is_zero():
                            continue
                        wk = vsix[lmtov[w.lm()]]
                        g.add_edge(vk,wk)
                    
        return Poset(g)
    
    def get_poset_info_for_search(self, tms, tms_high_to_low = (), tms_low_to_high = ()):
        P = self.get_poset(tms,tms_high_to_low,tms_low_to_high)
        wkabove = {wk : [] for wk in P}
        vkbelowcnt = {wk : 0 for wk in P}
        for vk,wk in P.cover_relations():
            wkabove[vk].append(wk)
            vkbelowcnt[wk] += 1
        vkstart = set()
        for vk in P:
            if vkbelowcnt[vk] == 0:
                vkstart.add(vk)
        return vkstart,vkbelowcnt,wkabove
    
    def get_quiver_representation(self,tms,tmcs=()):
        Q = DiGraph(multiedges=True)
        P = Poset((tms+tmcs,lambda a,b: all(i<=j for i,j in zip(a,b))))
        for tm,tmr in P.cover_relations():
        # for tm,tmr in product(tms+tmcs,tms+tmcs):
            # if tm == tmr or not all(i<=j for i,j in zip(tm,tmr)) or (tm not in tms and tmr not in tms):
            #     continue
            for wt,vs in self.get_vss(tm).items():
                for m in ba.all_monomials(tuple(map(sub,tmr,tm))):
                    vms = [liftR(self.J.reduce(liftR(v*m,self.R)),ba.R0)
                            for v in vs]
                    if all(vm.is_zero() for vm in vms):
                        continue
                    wtup = ba.polynomial_weight(next(vm for vm in vms if not vm.is_zero()))
                    ws = self.get_vss(tmr)[wtup]
                    Q.add_edge((tm,wt),(tmr,wtup),get_matrix_for_submodule(ws,vms))
        for tm in tms:
            for wt,vs in self.get_vss(tm).items():
                for x in ba.R0.gens()[ba.nvars:]:
                    xvs = [liftR(self.J.reduce(liftR(x*v-v*x,self.R)),ba.R0)
                            for v in vs]
                    if all(xv.is_zero() for xv in xvs):
                        continue
                    wtup = ba.polynomial_weight(next(vm for vm in xvs if not vm.is_zero()))
                    Q.add_edge((tm,wt),(tm,wtup),get_matrix_for_submodule(self.get_vss(tm)[wtup],xvs))
        return Q
    
    def get_linear_program2(self, tms, tmcs=(), relation_size_bound=oo, square_tests=()):
        Q = copy(self.get_quiver_representation(tms,tmcs))
        for v in Q:
            Q.set_vertex(v,set())
        for v,w,m in Q.edges(sort=False):
            Q.set_edge_label(v,w,linear_transformation(m,side='right'))
        queue = []
        def queue_add(v,M,unconditionally=False):
            assert M.degree() == len(self.get_vss(v[0])[v[1]])
            if unconditionally or M not in Q.get_vertex(v):
                print(v)
                print(M.matrix())
                Q.get_vertex(v).add(M)
                queue.append((v,M))
        distinguished_pairs = {}
        for v in Q:
            dim = len(self.get_vss(v[0])[v[1]])
            I = identity_matrix(self.ba.F,dim)
            F = [VectorSpace(self.ba.F,dim).subspace(I[:i]) for i in range(dim+1)]
            for i,(V1,V2) in enumerate(zip(F,F[1:])):
                distinguished_pairs[(v,V1,V2)] = self.get_vss(v[0])[v[1]][i].lm()
            for V in F:
                queue_add(v,V)
                # for _,w,f in Q.outgoing_edges(v):
                #     queue_add(w,f(V))
        while queue:
            v,M = queue.pop()
            for N in list(Q.get_vertex(v)):
            #     queue_add(v,M.intersection(N))
                queue_add(v,M + N)
            for _,w,f in Q.outgoing_edges(v):
                queue_add(w,f(M))
            # for w,_,f in Q.incoming_edges(v):
            #     queue_add(w,f.inverse_image(M))
        lp = MixedIntegerLinearProgram(solver='SCIP')
        lp.set_binary(lp.default_variable())
        def x(v,V,W):
            # assert V.ambient_vector_space().dimension() == W.ambient_vector_space().dimension() and \
            #     W.ambient_vector_space().dimension() == len(self.get_vss(v[0])[v[1]])
            # assert V.is_subspace(W) and V.dimension() + 1 == W.dimension()
            return lp[distinguished_pairs.get((v,V,W),(v,V,W))]
        tmsummands = {}
        for v,V1,V2 in distinguished_pairs:
            tmsummands.setdefault(v[0],[]).append( x(v,V1,V2) )
        for tm, summands in tmsummands.items():
            lp.add_constraint(lp.sum(summands) == self.ba.tm_dim_tperp(tm) - self.ba.tm_target_out(tm))
        for v in Q:
            P = Poset([Q.get_vertex(v),lambda a,b: a.is_subspace(b)])
            print(v,len(self.get_vss(v[0])[v[1]]), P)
            diamonds, all_completable = P.diamonds()
            assert all_completable
            for W,X,Y,Z in diamonds:
                lp.add_constraint( x(v,W,X) + x(v,X,Z) == x(v,W,Y) + x(v,Y,Z))
                lp.add_constraint( x(v,X,Z) >= x(v,W,Y) )
                lp.add_constraint( x(v,Y,Z) >= x(v,W,X) )
            for _,w,f in Q.outgoing_edges(v):
                for V,W in P.cover_relations_iterator():
                    fV,fW = f(V), f(W)
                    if fV != fW:
                        lp.add_constraint( x(w,fV,fW) >= x(v,V,W) )
        return lp
                
    def get_linear_program(self, r, tms, tmcs=(), relation_size_bound=oo, square_tests=(), search_bound=500):
        lp = self.get_linear_program_except_r(tms, tmcs, relation_size_bound, square_tests, search_bound)
        lp = copy(lp)
        
        for tm in tms + tmcs:
            lp.add_constraint(lp.sum(1-lp[v.lm()] 
                    for v in self.get_vs(tm)) == self.ba.tm_target_out(r,tm))
            
        def square_tm_bound(tm):
            return (1+sum(d-1 for d,k in zip(ba.dims,tm) if k>0))*r
        for tm in square_tests:
            lp.add_constraint(lp.sum(1-lp[(v.lm(),2)] 
                    for v in self.get_vs(tm)) >= square_tm_bound(tm))
            
        return lp

    def get_linear_program_except_r(self, tms, tmcs=(), relation_size_bound=oo, square_tests=(), search_bound=500):
        lp = MixedIntegerLinearProgram(solver='SCIP')
        lp.set_binary(lp.default_variable())

        constraints = SetSystem()
        nconstraints = 0
        from operator import concat
        def add_constraint(rowvks,colvks,kerdim,deduplp=None):
            assert kerdim <= len(colvks)
            if len(colvks) == kerdim:
                return False
            S = [('r',vk) for vk in rowvks]+[('c',vk) for vk in colvks]
            for Ss,ciks in constraints.iter_unions(S):
                rowvks1 = []
                colvks1 = []
                for tag,vk in reduce(concat,Ss):
                    if tag == 'r':
                        rowvks1.append(vk)
                    else:
                        colvks1.append(vk)
                if kerdim-len(colvks) >= sum(kerdim1 for _,kerdim1 in ciks)-len(colvks1):
                    # this condition is one we have added plus conditions 
                    # x <= 1 or 0 <= x
                    return False
            if deduplp is not None:
                from sage.numerical.mip import MIPSolverException
                cc = deduplp.sum(deduplp[self.get_vss(tm)[wt][i].lm()] for tm,wt,i in rowvks) + kerdim - \
                     deduplp.sum(deduplp[self.get_vss(tm)[wt][i].lm()] for tm,wt,i in colvks)
                deduplp.set_objective(cc)
                deduplp.set_min(deduplp.default_variable(),0)
                deduplp.set_max(deduplp.default_variable(),1)
                s = deduplp.solve()
                deduplp.set_objective(0)
                if s >= -1e-9:
                    return False
                deduplp.add_constraint(cc >= 0)
            prows = [self.get_vss(tm)[wt][i] for tm,wt,i in rowvks]
            pcols = [self.get_vss(tm)[wt][i] for tm,wt,i in colvks]
            if len(prows) > 1:
                print(prows,pcols,kerdim)
            nonlocal nconstraints
            constraints.add_set(S, (nconstraints,kerdim))
            nconstraints += 1
            lp.add_constraint(lp.sum(lp[self.get_vss(tm)[wt][i].lm()]
                                         for tm,wt,i in colvks)
                             <= lp.sum(lp[self.get_vss(tm)[wt][i].lm()] 
                                         for tm,wt,i in rowvks) + kerdim)
            return True
        
        def relation_size_bound_ncols(ncols):
            if 2**ncols <= search_bound:
                bound = ncols
            else:
                cur = 0
                for bound in count():
                    cur += binomial(ncols,bound)
                    if cur > search_bound:
                        bound -= 1
                        break
            bound = min(max(bound,1),relation_size_bound)
            return bound
        
        Q = self.get_quiver_representation(tms,tmcs)
        for alpha in Q.vertices(sort=True):
            print(alpha)
            es = [(beta,m) for beta,_,m in Q.incoming_edges(alpha)]
            if len(es) > 0:
                colvks = [(tm,wt,i) for (tm,wt),m in es for i in range(len(self.get_vss(tm)[wt]))]
                rowvks = [alpha+(i,) for i in range(len(self.get_vss(alpha[0])[alpha[1]]))]
                g = DiGraph([range(len(colvks)),[(i,i+1) for i,(a,b) in enumerate(zip(colvks,colvks[1:])) if a[:2] == b[:2] ]],
                            format='vertices_and_edges')
                M = block_matrix([[m for _,m in es]])
                deduplp = MixedIntegerLinearProgram(solver='SCIP',maximization=False)
                # deduplp = None
                for rows,cols in sorted(get_flag_inequalities2(M,g,relation_size_bound=relation_size_bound_ncols(M.ncols())),key=lambda f: len(f[0])):
                    rowvkscur = [rowvks[i] for i in rows]
                    colvkscur = [colvks[j] for j in cols]
                    add_constraint(rowvkscur, colvkscur, 0, deduplp)
            es = [(beta,m) for _,beta,m in Q.outgoing_edges(alpha)]
            if len(es) > 0:
                colvks = [(tm,wt,i) for (tm,wt),m in es for i in range(len(self.get_vss(tm)[wt])-1,-1,-1)]
                rowvks = [alpha+(i,) for i in range(len(self.get_vss(alpha[0])[alpha[1]])-1,-1,-1)]
                g = DiGraph([range(len(colvks)),[(i,i+1) for i,(a,b) in enumerate(zip(colvks,colvks[1:])) if a[:2] == b[:2] ]],
                            format='vertices_and_edges')
                M = block_matrix([[m.T[::-1,::-1] for _,m in es]])
                deduplp = MixedIntegerLinearProgram(solver='SCIP',maximization=False)
                # deduplp = None
                for rows,cols in sorted(get_flag_inequalities2(M,g,relation_size_bound=relation_size_bound_ncols(M.ncols())),key=lambda f: len(f[0])):
                    rowvkscur = [rowvks[i] for i in rows]
                    colvkscur = [colvks[j] for j in cols]
                    add_constraint(colvkscur, rowvkscur, 0, deduplp)
            
        @cache
        def conjunction_variable(vks):
            vs = tuple( self.get_vss(tm)[wt][i].lm() for tm,wt,i in vks )
            if len(vs) == 1:
                return lp[vs[0]]
            lp.add_constraint(lp.sum(lp[v] for v in vs) <= lp[vs] + len(vs)-1)
            for v in vs:
                lp.add_constraint(lp[vs] <= lp[v])
            return lp[vs]
            
        pair_constraints = SetSystem()
        def add_square_constraint(rowvks,colvks,colvkss,kerdim):
            ncols = len(colvks) + len(colvkss)
            assert kerdim <= ncols
            if ncols == kerdim:
                return False
            colvkss = [tuple(sorted(vks)) for vks in colvkss]
            S = [('r',vk) for vk in rowvks]+[('c',vk) for vk in colvks]+[('cp',vks) for vks in colvkss]
            for Ss,ks in pair_constraints.iter_unions(S):
                if kerdim-ncols >= sum(ks)-len([None for R in Ss for tag,_ in R if tag in ['c','cp']]):
                    # this condition is one we have added plus conditions 
                    # x <= 1 or 0 <= x
                    assert len(rowvks) > 1
                    return False
            prows = [self.get_vss(tm)[wt][i] for tm,wt,i in rowvks]
            pcols = [self.get_vss(tm)[wt][i] for tm,wt,i in colvks]+[[self.get_vss(tm)[wt][i] for tm,wt,i in vks] for vks in colvkss]
            if len(prows) > 1:
                print(prows,pcols,kerdim)
            pair_constraints.add_set(S, kerdim)
            lp.add_constraint(lp.sum(lp[(self.get_vss(tm)[wt][i].lm(),2)] for tm,wt,i in colvks) + \
                              lp.sum(lp[conjunction_variable(vks)] for vks in colvkss)
                             <= lp.sum(lp[(self.get_vss(tm)[wt][i].lm(),2)] for tm,wt,i in rowvks) + kerdim)
            return True

        Psquare = Poset((square_tests,lambda a,b: all(i<=j for i,j in zip(a,b))))
        for tm1,tm2 in Psquare.cover_relations():
            for m in self.ba.all_monomials(tuple(map(sub,tm2,tm1))):
                for n in self.ba.all_monomials(tm1):
                    lp.add_constraint(lp[(n,2)] <= lp[(m*n,2)])
                    
        wtspaces = {}
        for tm1,tm2 in combinations_with_replacement(tms,2):
            from operator import add
            tm = tuple(map(add,tm1,tm2))
            if tm in square_tests:
                for (wt1,vs1),(wt2,vs2) in product(self.get_vss(tm1).items(),self.get_vss(tm2).items()):
                    if tm1 == tm2 and wt1 > wt2:
                        continue
                    wt = tuple(map(add,wt1,wt2))
                    vs = self.get_vss(tm)[wt]
                    if (tm1,wt1) == (tm2,wt2):
                        prods = [v*w for v,w in combinations_with_replacement(vs1,2)]
                    else:
                        prods = [v*w for v,w in product(vs1,vs2)]
                    m = get_matrix_for_submodule(vs,prods)
                    wtspaces.setdefault((tm,wt),[]).append(((tm1,wt1),(tm2,wt2),m))
        for alpha,below_pairs in wtspaces.items():
            M = block_matrix([[m for beta1,beta2,m in below_pairs]])
            g = DiGraph()
            c = 0
            colvkss = []
            for (tm1,wt1),(tm2,wt2),_ in below_pairs:
                if (tm1,wt1) == (tm2,wt2):
                    cnt = len(self.get_vss(tm1)[wt1])
                    colvkss.extend([ [(tm1,wt1,i),(tm1,wt1,j)]  for i,j in combinations_with_replacement(range(cnt),2)])
                    ixmap = { (i,j) : c+k for k,(i,j) in enumerate(combinations_with_replacement(range(cnt),2)) }
                    for k in range(binomial(cnt+1,2)):
                        g.add_vertex(c+k)
                    for i,j in combinations_with_replacement(range(cnt),2):
                        if j < cnt-1:
                            g.add_edge( ixmap[(i,j)], ixmap[(i,j+1)] )
                        if i < j:
                            g.add_edge( ixmap[(i,j)], ixmap[(i+1,j)] )
                    c += binomial(cnt+1,2)
                else:
                    cnt1 = len(self.get_vss(tm1)[wt1])
                    cnt2 = len(self.get_vss(tm2)[wt2])
                    colvkss.extend([ [(tm1,wt1,i),(tm2,wt2,j)]  for i,j in product(range(cnt1),range(cnt2))])
                    for i in range(cnt1):
                        g.add_vertex(c+i*cnt2)
                        for j in range(cnt2-1):
                            g.add_edge(c+i*cnt2+j, c+i*cnt2+j+1)
                    for j in range(cnt2):
                        g.add_vertex(c+j)
                        for i in range(cnt1-1):
                            g.add_edge(c+i*cnt2+j, c+(i+1)*cnt2+j)
                    c += cnt1 * cnt2
            rowvks = [alpha+(i,) for i in range(len(self.get_vss(alpha[0])[alpha[1]]))]
            for rows,cols in sorted(get_flag_inequalities2(M,g,relation_size_bound=relation_size_bound_ncols(M.ncols())),key=lambda f: len(f[0])):
                rowvkscur = [rowvks[i] for i in rows]
                colvksscur = [colvkss[j] for j in cols]
                add_square_constraint(rowvkscur, [], colvksscur, 0)
                              
            
