    def get_quiver_representation_with_preserved_subspaces(self,tms,tmcs=()):
        queue = []
        Q = DiGraph()
        def queue_add(v,M,unconditionally=False):
            assert M.degree() == len(self.get_vss(v[0])[v[1]])
            if unconditionally or M not in Q.get_vertex(v):
                print(M.matrix())
                queue.append((v,M))
        for v in self.get_quiver_representation(tms,tmcs).vertices(sort=False):
            Q.add_vertex(v)
            Q.set_vertex(v, set())
            dim = len(self.get_vss(v[0])[v[1]])
            queue_add(v,VectorSpace(self.ba.F,dim).subspace(identity_matrix(self.ba.F,dim)))
            queue_add(v,VectorSpace(self.ba.F,dim).zero_subspace())
        for v,w,f in self.get_quiver_representation(tms,tmcs).edges(sort=False):
            Q.add_edge(v,w,linear_transformation(f,side="right"))
        while queue:
            v,M = queue.pop()
            Q.get_vertex(v).add(M)
            for N in Q.get_vertex(v):
                queue_add(v,M.intersection(N))
            #     queue_add(v,M + N)
            # for _,w,f in Q.outgoing_edges(v):
            #     queue_add(w,f(M))
            for w,_,f in Q.incoming_edges(v):
                queue_add(w,f.inverse_image(M))
        # for v in Q:
        #     for V in Q.get_vertex(v):
        #         queue_add(v,V,True)
        # while queue:
        #     v,M = queue.pop()
        #     Q.get_vertex(v).add(M)
        #     # for N in Q.get_vertex(v):
        #     #     queue_add(v,M.intersection(N))
        #     #     queue_add(v,M + N)
        #     for _,w,f in Q.outgoing_edges(v):
        #         queue_add(w,f(M))
        #     # for w,_,f in Q.incoming_edges(v):
        #     #     queue_add(w,f.inverse_image(M))
        return Q
    
    def get_linear_program_preserved_subspaces(self,tms,tmcs=()):
        def subspaces_to_graph(Vs):
            g = DiGraph()
            cols = []
            tops = {}
            P = Poset([Vs,lambda a,b: a.is_subspace(b)])
            c = 0
            contained_vectors = {}
            # pair_intervals = {}
            for W in P.linear_extension():
                tops[W] = []
                for V,_,_ in P.hasse_diagram().incoming_edges(W):
                    nvert = len(g)
                    ixs = block_matrix([ [V.matrix()], [W.matrix()[::-1]] ]).pivot_rows()
                    ixs = [V.dimension()+W.dimension()-1-i for i in ixs[V.dimension():]]
                    ixs.reverse()
                    for i in ixs:
                        cols.append(W.matrix().row(i))
                    g.add_vertex(c)
                    for i in range(len(ixs)-1):
                        g.add_edge(c+i,c+i+1)
                    for i in tops[V]:
                        g.add_edge(i,c)
                    tops[W].append(c+len(ixs)-1)
                    for W2 in P.order_filter([W]):
                        contained_vectors.setdefault(W2,[]).extend(range(c,c+len(ixs)))
                    # pair_intervals[(V,W)] = (c,c+len(ixs))
                    c += len(ixs)
            M = matrix(self.ba.F,cols).T
            return M,g,contained_vectors,P
                    
        Q = self.get_quiver_representation_with_preserved_subspaces(tms,tmcs)
        lp = MixedIntegerLinearProgram(solver='SCIP')
        lp.set_binary(lp.default_variable())
        vertex_data = {}
        for alpha in Q:
            print(alpha)
            Vs = Q.get_vertex(alpha)
            M,g,contained_vectors,P = subspaces_to_graph(Vs)
            banned_sets = []
            Vdim = {}
            for V in sorted(Vs,key=lambda V: V.dimension()):
                print(V)
                gcur = g.subgraph(vertices=contained_vectors.get(V,[]))
                jxscurrev = gcur.relabel(return_map=True)
                jxscur = [None for i in range(len(gcur))]
                for j,i in jxscurrev.items():
                    jxscur[i] = j
                Mcur = M[:,jxscur]
                try:
                    assert len(gcur) >= V.dimension() and Mcur.rank() == V.dimension()
                except:
                    embed()
                    raise
                banned_sets_cur = [[jxscurrev[i] for i in s] for s in banned_sets if set(s).issubset(jxscurrev)]
                banned_sets_indices = [[] for j in range(Mcur.ncols())]
                for si,s in enumerate(banned_sets_cur):
                    for j in s:
                        banned_sets_indices[j].append(si)
                def prunef(jxs,jxsmissing):
                    banned_sets_remaining = [len(s) for s in banned_sets_cur]
                    for j in jxs:
                        for si in banned_sets_indices[j]:
                            banned_sets_remaining[si] -= 1
                            if banned_sets_remaining[si] == 0:
                                return False
                    return True
                for kxs in get_fillings(Mcur,gcur,prunef=prunef):
                    jxs = [jxscur[j] for j in kxs]
                    assert len(jxs) == V.dimension()
                    print(jxs)
                    if V not in Vdim:
                        Vdim[V] = lp.sum(lp[alpha+(j,)] for j in jxs)
                    else:
                        banned_sets.append(jxs)
                        lp.add_constraint(lp.sum(lp[alpha+(j,)] for j in jxs) == Vdim[V])
            vertex_data[alpha] = (Vdim, P)
        for tm in tms+tmcs:
            lp.add_constraint(lp.sum(Vdim[P.maximal_elements()[0]] for wt in self.get_vss(tm) 
                                     for Vdim,P in [vertex_data[(tm,wt)]]) == self.ba.tm_dim_tperp(tm) - self.ba.tm_target_out(tm))
        for alpha,beta,f in Q.edges(sort=False):
            print(alpha,beta)
            Vdim2,P2 = vertex_data[beta]
            Vdim1,P1 = vertex_data[alpha]
            for V,W in P2.cover_relations_iterator():
                fiV = f.inverse_image(V)
                fiW = f.inverse_image(W)
                if fiV != fiW:
                    lp.add_constraint(Vdim2[W] - Vdim2[V] >= Vdim1[fiW] - Vdim1[fiV])
                    
            
            # g.add_vertices(['bottom','top'])
            # for i in g:
            #     if i != 'bottom' and i != 'top':
            #         if g.in_degree(i) == 0:
            #             g.add_edge('bottom',i)
            #         if g.out_degree(i) == 0:
            #             g.add_edge(i,'top')
            # for c in g.to_undirected().cycle_basis():
