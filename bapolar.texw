def liftR(p,R):
    if p.parent() is R:
        return p
    if p.is_zero():
        return R.zero()
    return p(R.gens()[:p.parent().ngens()]+(R.zero(),)*(p.parent().ngens()-R.ngens()))

def emultiset(p):
    return [xi for xi,e in p.exponents()[0].sparse_iter() for _ in range(e)]

def bounded_gb(J, d):
    # return J.twostd()
    from sage.libs.singular.option import opt,opt_ctx
    nonparam_weight = J.ring().term_order()[0].weights()[0]
    sav = [p for p in J.gens() if p.degree() >= nonparam_weight*(d+1)]
    with opt_ctx:
        opt['deg_bound'] = nonparam_weight*(d+1)-1
        return J.ring().ideal(J.twostd().gens()+tuple(sav),side='twosided')
    return res

# ps in span of qs, find matrix expressing each 
# p as a linear combination of the qs
def get_matrix_for_submodule(qs,ps):
    # return ff.lift(self.ba.R0.ideal(qs), self.ba.R0.ideal(ps)).apply_map(lambda e: e.constant_coefficient())
    ms = []
    mdict = {}
    A = {}
    for pi,p in enumerate(ps):
        for m in p.monomials():
            if m not in mdict:
                mdict[m] = len(ms)
                ms.append(m)
            A[(mdict[m],pi)] = p.monomial_coefficient(m)
    B = {}
    for pi,p in enumerate(qs):
        for m in p.monomials():
            if m not in mdict:
                mdict[m] = len(ms)
                ms.append(m)
            B[(mdict[m],pi)] = p.monomial_coefficient(m)
    A = matrix(ps[0].base_ring(),len(ms),len(ps),A)
    B = matrix(ps[0].base_ring(),len(ms),len(qs),B)
    return B.dense_matrix().solve_right(A)

def basis_of_lie_algebra(xs):
    n = xs[0].dimensions()[0]
    F = xs[0].base_ring()
    B = copy(xs)
    Q = copy(xs)
    have = matrix(F,len(B),n*n,[x.list() for x in xs],sparse=True)
    have.echelonize()
    assert have.rank() == have.nrows()
    while len(Q) > 0:
        y = Q.pop()
        for x in xs:
            z = x*y-y*x
            havez = block_matrix([[have],[matrix(z.list(),sparse=True)]])
            havez.echelonize()
            if havez.rank() > have.nrows():
                have = havez
                B.append(z)
                Q.append(z)
    return B

def irrelevant_tm_generators(tms):
    R = PolynomialRing(QQ,'x',len(tms[0]))
    Is = [R.ideal([t**(e+1) for e,t in zip(tm,R.gens())]) for tm in tms]
    I = Is[0].intersection(*Is[1:])
    return [tuple(m.exponents()[0]) for m in I.gens()]

def write_JS(J,S,f):
    print ('writing %s' %f)
    f = open(f,'w')
    for s in S:
        f.write(str(s)+'\n')
    f.write('\n')
    for p in J.gens():
        f.write(str(p)+'\n')
    f.close()
    
def read_JS(ba,f):
    f = open(f).read()
    import re
    ti = re.findall('t([0-9]+)',f)
    tmax = 0 if len(ti) == 0 else max(map(eval,ti))+1
    R = ba.get_ring(tmax)
    locals = {str(x):x for x in R.gens()}
    f = f.split('\n')
    S = []
    J = []
    inS = True
    for l in f:
        if len(l) == 0:
            inS = False
            continue
        if inS:
            S.append(R(sage_eval(l,locals=locals)))
        else:
            J.append(R(sage_eval(l,locals=locals)))
    return R.ideal(J,side='twosided'),S,tmax

def square(ba,Jxi,tms=None,k=2):
    J,xi = Jxi
    if J.is_zero():
        return (J,xi)
    gs = [p for p in J.gens() if not ba.lm(p).is_constant()]
    J = J.ring().ideal([p for p in J.gens() if ba.lm(p).is_constant()] + [prod(es) for es in combinations_with_replacement(gs,k) if 
                      tms is None or reduce(lambda e,f: tuple(map(lambda e,f: e+f, e, ba.polynomial_tm(f))),es,(0,)*len(ba.dims)) in tms],side='twosided')
    I,subs = JxiDat(ba,(J,xi)).forget_xs()
    return J.ring().ideal([p(subs) for p in I.interreduced_basis()],side='twosided')

# remove when added to itertools
def batched(iterable, n):
    "Batch data into tuples of length n. The last batch may be shorter."
    if n < 1:
        raise ValueError('n must be at least one')
    it = iter(iterable)
    while batch := tuple(islice(it, n)):
        yield batch
    
