def search_by_sequence(ba,r,tmss,Jxi=None,mode=('individual',10),test_squares=True):
    together = mode == 'together'
    individual = type(mode) is tuple and mode[0] == 'individual'
    def dfs(Jxi,tmsi):
        try:
            tms = tmss[tmsi]
        except IndexError:
            yield Jxi
            return
        d = sum(tms[0])
        bounds, ltIlb, ltIub = ba.codimension_bounds(Jxi,d)
        if ltIlb.hilbert_series() == ba.target_hilbert_series_td(r) and \
                ltIub.hilbert_series() == ba.target_hilbert_series_td(r):
            yield Jxi
            return
        J,xi = Jxi
        core = ba.ideal_constant_generators(J)
        mod = ba.zero if core.is_zero() else JDat(ba,core) 
        tms = tuple(sorted([tm for tm in tms if 
            not all(bound == min(ba.tm_dim(tm),r) for bound in bounds[tm]) ]))
        if len(tms) == 0:
            for res in dfs(Jxi, tmsi+1):
                yield res
            return
        # maxdincrease = max(d-2,0) + max(ba.T.degree()-2,0)
        maxdincrease = max(0,min(max(d-1, ba.T.degree()-d),r-d))
        # maxdincrease = d
        # maxdincrease = max(1, min(d, 9-d))
        tmcs = tuple(sorted(set([tuple(map(add,tm,tma)) for tm in tms for k in range(1,maxdincrease+1)
                             for tma in IntegerVectors(k,len(ba.dims)) ])))
        extra_square_increase = 0
        def get_square_tests(tms):
            if not test_squares:
                return []
            existing_tms = list(set(list(tms)+[ba.polynomial_tm(p) for p in mod.J.gens() if not p.is_zero()]))
            mindegree = min(sum(tm) for tm in existing_tms)
            return tuple(set([ tuple(map(add,tm1,tm2)) for tm1,tm2 in combinations_with_replacement(existing_tms,2)
                                     if sum(tm1) + sum(tm2) <= d + mindegree + extra_square_increase ]))
        square_tests = get_square_tests(tms)
        if together:
            for Jxiup in ba.get_ideals_for_tm(r, tms, tmcs, Jxi, mod=mod, square_tests=square_tests):
                for res in dfs(Jxiup,tmsi+1):
                    yield res
        elif individual:
            ibatch = mode[1]
            tmcss = [tuple([tmc for tmc in tmcs if all(e <= f for e,f in zip(tm,tmc))])
                          for tm in tms]
            square_testss = [get_square_tests([tm]) for tm in tms]
            if J.is_zero():
                tmcss = [tuple([tmc for tmc in tmcscur if all(e > 0 or f == 0 for e,f in zip(tm,tmc)) ]) 
                         for tmcscur,tm in zip(tmcss,tms)]
            tmcs_last_check = tuple([tmc for tmc in tmcs
                          if len([tm for tm in tms if all(e <= f for e,f in zip(tm,tmc))]) > 1 ])
            square_tests_last_check = tuple([tm for tm in square_tests if 
                                       [tm in square_tests_cur for square_tests_cur in square_testss ].count(True) != 1 ])
            gens = [ba.get_ideals_for_tm(r,(tm,),tmcscur,Jxi,mod=mod,simplify_existing=False,square_tests=square_tests_cur) 
                    for tm,tmcscur,square_tests_cur in zip(tms,tmcss,square_testss)]
            def constrs(tm,sols):
                from sage.libs.singular.groebner_strategy import NCGroebnerStrategy
                xs = [x.lm() for x in mod.get_vs(tm)]
                pts = [ tuple(sorted([ x for x in xs if Jn.normal_form( liftR(x,J.ring()) ) == liftR(x,J.ring()) ]))
                        for J,_ in sols for Jn in [NCGroebnerStrategy(J)] ]
                return (pts,get_positive_constraints(pts,xs))
            
            batched_gen = lambda tm,gen: ((sols,)+ constrs(tm,sols) for sols in batched(gen,ibatch))
            gens = [batched_gen(tm,gen) for tm,gen in zip(tms,gens)]
            
            for solss in lproduct(*map(enumerate,gens)):
                print ('index choice %d' % tmsi,[i for i,_ in solss])
                lp = mod.get_linear_program(r,(),tms+tmcs_last_check,square_tests=square_tests_last_check)
                pttosol = {}
                for tm,(_,(sols,pts,curconstrs)) in zip(tms,solss):
                    xs = [x.lm() for x in mod.get_vs(tm) ]
                    add_positive_constraints(lp,xs,curconstrs)
                    for sol,pt in zip(sols,pts):
                        pttosol.setdefault(pt,[]).append(sol)
                bp = BinaryProgram(lp)
                for sol in bp_integer_points(bp,[x.lm() for tm in tms for x in mod.get_vs(tm)]):
                    tmpt = {}
                    for x,v in sol.items():
                        if v == 0:
                            tm = ba.polynomial_tm(x)
                            if tm in tms:
                                tmpt.setdefault(tm,[]).append(x)
                    for solscur in product(*[pttosol[tuple(sorted(pt))] for _,pt in tmpt.items()]):
                        Ixi = ba.sum_ideals(solscur,xi)
                        for Jxiup in ba.get_ideals_for_tm(r, (), tms+tmcs_last_check, Ixi, 
                                                          mod=mod, square_tests=square_tests_last_check):
                            for res in dfs(Jxiup,tmsi+1):
                                yield res
        else:
            raise ValueError('mode invalid')
    return dfs((ba.R0.ideal(side='twosided'),0) if Jxi is None else Jxi,0)

def lp_look_strict_by_deg(ba,r,deg_bound=2,Jxi=None,mode=('individual',10)):
    tmss = [list(map(tuple,IntegerVectors(k,len(ba.dims)))) for k in range(1,deg_bound+1)]
    return search_by_sequence(ba,r,tmss,Jxi,mode=mode)

def lp_look_strict(ba,r,deg_bound=2,tm_max_bound=oo,Jxi=None,mode=('individual',10)):
    tmss = [[tuple(tm) for tm in IntegerVectors(k,len(ba.dims)) if max(tm) == tmm] for k in range(1,deg_bound+1)
            for tmm in range( (k-1)//len(ba.dims)+1, min(tm_max_bound,k)+1 ) ]
    # tmss = [[tm for tm in tms if all( e<=f for e,f in zip(tm,(3,1,1)))] for tms in tmss]
    # tmss = [tms for tms in tmss if len(tms) > 0]
    # tmss = [[(1,1,0),(1,0,1)]] + tmss
    # tmss = [[(1,1,0)],[(1,0,1)]] + tmss
    # tmss = [[(1,1,0)],[(1,0,1)]] + tmss
    # tmss = [[(1,1,0)],[(1,0,1),(0,1,1)]] + tmss
    # tmss = [[(1,1,0),(1,0,1),(0,1,1),(2,0,0)]] + tmss
    # tmss = [[(1,1,0),(1,0,1),(0,1,1)],[(2,0,0)]] + tmss
    print(tmss)
    return search_by_sequence(ba,r,tmss,Jxi,mode=mode)

def three_place_ideals_up_to(ba,d=1,Jxi=None):
    def dfs(Jxi,tms,mod=ba.zero): 
        if len(tms) == 0:
            yield Jxi
            return
        tm = tms[0]
        print (tm)
        # J,S,xi = Jxi
        for Jxiup in ba.get_ideals_for_tm([tm], [tm[:s]+(tm[s]+1,)+tm[s+1:] for s in range(3)]
                      +([(2,2,2)] if sum(tm) == 4 and all(e <= 2 for e in tm) else []),
                  Jxi,search_tmcs = sum(tm) == 2, lp_interval_length_bound = 3
                                          if sum(tm) <= 3 else 2, mod = mod):
            if len(tms) == 1 and sum(tm) < d:
                ltIlb, ltIub = ba.leading_term_ideal(Jxiup)
                R = ltIlb.ring()
                
                degseries = ltIlb.hilbert_series() == ba.target_hilbert_series_td() and \
                    ltIub.hilbert_series() == ba.target_hilbert_series_td()
                
                for dnext in range(sum(tm)+1,d+1):
                    print (dnext)
                    tmsnext = []
                    if dnext > 3 and degseries:
                    # if dnext > sum(tm)+1 and dnext > 3 and degseries:
                        break
                    for tmc in IntegerVectors(dnext,3):
                        tmc = tuple(tmc)
                        codim_upper_bound = len([m for m in mod.get_vs(tmc) if liftR(m.lm(),R) not in ltIlb]) + ba.tm_codim_tperp(tmc)
                        codim_noadd_lower_bound = len([m for m in mod.get_vs(tmc) if liftR(m.lm(),R) not in ltIub]) + ba.tm_codim_tperp(tmc)
                        if codim_upper_bound != ba.r or codim_noadd_lower_bound != ba.r:
                            tmsnext.append((tmc,codim_upper_bound))
                    if len(tmsnext) > 0:
                        break
                tmsnext.sort(key = lambda p: (p[1], max(p[0]), p[0]))
                print(tmsnext)
                tmsnext = [tmc for tmc,_ in tmsnext]
                modnext = JDat(ba,ba.ideal_constant_generators(Jxiup[0]))
            else:
                tmsnext = tms[1:]
                modnext = mod
                
            for Jxifull in dfs(Jxiup,tmsnext,modnext):
                    yield Jxifull

    if Jxi is not None:
        mod = JDat(ba,ba.ideal_constant_generators(Jxi[0]))
        for Jxifull in dfs(Jxi, [(1,0,0),(0,1,0),(0,0,1)], mod):
            yield Jxifull
        return

    cd2 = [ ba.get_ideals_for_tm([(1,1,0)],tmcs=[(2,1,0),(1,2,0)]) ]
    cd2.append(ba.get_ideals_for_tm([(1,0,1)],tmcs=[(2,0,1),(1,0,2)]))
    cd2.append(ba.get_ideals_for_tm([(0,1,1)],tmcs=[(0,2,1),(0,1,2)]))

    for Jxis in lproduct(*map(enumerate,cd2)):
        print ('triple',[i for i,Iyi in Jxis])
        Jxi = ba.sum_ideals([Iyi for i,Iyi in Jxis])
        try:
            next(ba.get_ideals_for_tm([],[(1,1,1)],Jxi))
            for Jxifull in dfs(Jxi,[(2,0,0),(0,2,0),(0,0,2)] if d >= 2 else []):
                yield Jxifull
        except StopIteration:
            pass
        
def lp_only_look_nonstrict(ba):
    from operator import concat
    from sage.numerical.mip import MIPSolverException
    tms = [(1,1,0),(1,0,1),(0,1,1)]
    tmcss = [((2,1,0),(1,2,0)), 
              ((2,0,1),(1,0,2)),
              ((0,2,1),(0,1,2))]
    ips = [ IntegerProgram(ba.zero.get_linear_program((tm,),tmcs,relation_size_bound=8),
                           [p.lm() for p in ba.zero.get_vs(tm)])
            for lpi,(tm,tmcs) in enumerate(zip(tms,tmcss)) ]
    def prunef(psol):
        psols = [[] for _ in tms]
        for x,v in psol.items():
            psols[tms.index(ba.polynomial_tm(x))].append((x,v))
        for psol, ip in zip(psols,ips):
            if not ip.can_extend_psol(psol):
                return False
        return True
    lp = ba.zero.get_linear_program(((1,1,0),(1,0,1),(0,1,1)),((1,1,1),),
                                    relation_size_bound=4)
    xs = [x.lm() for tm in tms for vs in ba.zero.get_vss(tm).values() for x in vs]
    
    @cache
    def getJxis(lpi,sol):
        tm = tms[lpi]
        tmcs = tmcss[lpi]
        return list(ba.get_ideals_for_tm((tm,),tmcs,preset_choices=dict(sol)))
    
    for fsol in lp_integer_points(lp,xs,fullsol=False,prunef=prunef):
        sols = [{} for _ in tms]
        for x,v in fsol.items():
            sols[tms.index(ba.polynomial_tm(x))][x] = v
        Jxiss = []
        for Jxis in product(*[getJxis(lpi,tuple(sorted(sol.items()))) 
                              for lpi, sol in enumerate(sols)]):
            Jxi = ba.sum_ideals(Jxis)
            try:
                next(ba.get_ideals_for_tm([],[(1,1,1)],*Jxi))
                yield Jxi
            except StopIteration:
                pass

def lp_only_look_strict(ba,bound=5000):
    from operator import concat
    from sage.numerical.mip import MIPSolverException
    tms = [(1,1,0),(1,0,1),(0,1,1)]
    # tmcss = [((2,1,0),(1,2,0)), 
    tmcss = [((2,1,0),(1,2,0)),
              ((2,0,1),(1,0,2)),
              ((0,2,1),(0,1,2))]
    sols_ss = []
    for tm,tmcs in zip(tms,tmcss):
        lpcur = ba.zero.get_linear_program((tm,),tmcs,relation_size_bound=10)
        xs = [x.lm() for vs in ba.zero.get_vss(tm).values() for x in vs]
        ss = SetSystem()
        sols_ss.append(ss)
        for si,solall in enumerate(lp_integer_points(lpcur,xs,fullsol=False)):
            print(tm,si)
            sol = [m for m,v in solall.items() if v==0]
            ss.add_set(sol)
    @cache
    def getJxis(lpi,sol):
        tm = tms[lpi]
        tmcs = tmcss[lpi]
        preset_choices = {v.lm() : True for v in ba.zero.get_vs(tm)}
        preset_choices.update({m.lm() : False for m in sol})
        res = list(ba.get_ideals_for_tm((tm,),tmcs,preset_choices=preset_choices))
        if len(res) == 0:
            sols_ss[lpi].remove_set(sol)
        return res
    def prunef(psol):
        Slohis = [([],set([v.lm() for vs in ba.zero.get_vss(tm).values() 
                       for v in vs])) for tm in tms]
        for m,v in psol.items():
            lpj = tms.index(ba.polynomial_tm(m))
            if v == 0:
                Slohis[lpj][0].append(m)
            else:
                Slohis[lpj][1].remove(m)
        return all( any(True for _,si in ss.iter_sets(Slo,Shi) )
                   for ss,(Slo,Shi)
                   in zip(sols_ss,Slohis) )
    def initial_dfs(lp,faci,Slo,Shi,ys):
        ss = sols_ss[faci]
        cnttot = 0
        cnts = {y : 0 for y in ys}
        for sol,_ in ss.iter_sets(Slo,Shi):
            for y in sol:
                if y in ys:
                    cnts[y] += 1
            cnttot += 1
        print('initial_dfs',faci,cnttot)
        if cnttot < bound:
            lp = deepcopy(lp)
            add_positive_constraints(lp,(sol for sol,_ in ss.iter_sets(Slo,Shi)),ys)
            if faci+1 >= len(tms):
                xs = [x.lm() for tm in tms for vs in ba.zero.get_vss(tm).values() for x in vs]
                # for fsol in lp_integer_points(lp,xs,fullsol=False):
                for fsol in lp_integer_points(lp,xs,fullsol=False,prunef=prunef):
                    sols = [[] for _ in tms]
                    for x,k in fsol.items():
                        if k == 0:
                            sols[tms.index(ba.polynomial_tm(x))].append(x)
                    sols = [tuple(sorted(sol)) for sol in sols]
                    Jxiss = [getJxis(lpj,sol) for lpj,sol in enumerate(sols)]
                    for Jxis in product(*Jxiss):
                        Jxi = ba.sum_ideals(Jxis)
                        for Kxi in ba.get_ideals_for_tm([],[(1,1,1)],Jxi):
                            yield Kxi
                return
            xs = set([x.lm() for vs in ba.zero.get_vss(tms[faci+1]).values() for x in vs])
            for res in initial_dfs(lp, faci+1, [], copy(xs), xs):
                yield res
            return
        x = min(ys, key=lambda x: abs(cnttot//2-cnts[x]))
        lp.set_min(lp[x],1.0)
        try:
            lp.solve(objective_only=True)
            Shi.remove(x)
            ys.remove(x)
            for res in initial_dfs(lp, faci, Slo, Shi, ys):
                yield res
            ys.add(x)
            Shi.add(x)
        except MIPSolverException:
            pass
        lp.set_min(lp[x],0.0)
        lp.set_max(lp[x],0.0)
        try:
            lp.solve(objective_only=True)
            Slo.append(x)
            ys.remove(x)
            for res in initial_dfs(lp, faci, Slo, Shi, ys):
                yield res
            ys.add(x)
            Slo.pop()
        except MIPSolverException:
            pass
        lp.set_max(lp[x],1.0)
    lp = deepcopy(ba.zero.get_linear_program(
        ((1,1,0),(1,0,1),(0,1,1)),((1,1,1),),relation_size_bound=4))
    xs = set([x.lm() for vs in ba.zero.get_vss(tms[0]).values() for x in vs])
    return initial_dfs(lp,0,[],copy(xs),xs)
            
    # @cache
    # def getJxis(lpi,sol):
    #     tm = tms[lpi]
    #     tmcs = tmcss[lpi]
    #     preset_choices = {v.lm() : True for v in ba.zero.get_vs(tm)}
