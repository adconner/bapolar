class JxiDat:
    def __init__(self, ba, Jxi):
        self.J, self.xi = Jxi
        self.ba = ba
        self.ltI = cache(self.ltI)
        self.normal_basis = cache(self.normal_basis)
        self.normal_basis_tm = cache(self.normal_basis_tm)

    def ltI(self):
        return self.ba.trivially_contained_leading_term_ideal((self.J,self.xi))
    
    def normal_basis(self, deg):
        return [liftR(m,self.ba.R0) for m in self.ltI().normal_basis(deg)]
    
    def normal_basis_tm(self, tm):
        return [m for m in self.normal_basis(sum(tm)) if self.ba.polynomial_tm(m) == tm]
    
    def forget_xs(self):
        order = TermOrder('wdegrevlex',[self.ba.nonparam_weight]*sum(self.ba.dims))
        # order = TermOrder('degrevlex',sum(self.ba.dims))
        if self.xi > 0:
            order = order + TermOrder('degrevlex',self.J.ring().ngens()-self.ba.nvarsx)
        R = PolynomialRing(self.ba.F,self.J.ring().gens()[:self.ba.nvars]+self.J.ring().gens()[self.ba.nvarsx:],order=order)
        subs = R.gens()[:self.ba.nvars] + (R.zero(),)*(self.ba.nvarsx-self.ba.nvars) + R.gens()[self.ba.nvars:]
        subsr = self.J.ring().gens()[:self.ba.nvars] + self.J.ring().gens()[self.ba.nvarsx:]
        return R.ideal([p(subs) for p in self.J.gens()]),subsr
    
